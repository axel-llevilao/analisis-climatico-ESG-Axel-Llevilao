# Copia este archivo a `.env` (no se versiona) y ajusta si hace falta.
# Todas las variables tienen un valor por defecto razonable.

# Carpeta local de caché de datos (raw/, staging/, marts/). Por defecto: ./data
# CLIMACHILE_DATA_DIR=/home/axel/datos/climachile

# Remoto rclone + carpeta raíz en Google Drive. Por defecto: gdrive:climachile-data
# CLIMACHILE_REMOTE=gdrive:climachile-data
